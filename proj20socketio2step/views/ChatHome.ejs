<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>채팅 기능 구현</h1>
    <div>
        <button id="chatConnectBtn">Chat 네임스페이스 연결</button>
        <button id="newsConnectBtn">News 네임스페이스 연결</button>
    </div>
    <p>
        메세지: <input type="text" id="messageInput" value="hello world">
        <button id="sendBtn">전송</button>
    </p>
    <div>
        결과: <ul id="messages"></ul>
    </div>
    
    <!-- <script src="/socket.io/socket.io.js"></script> -->
    <script src="https://cdn.socket.io/4.8.0/socket.io.min.js"></script>
    <script>
        const chatConnectBtn = document.getElementById('chatConnectBtn');
        const newsConnectBtn = document.getElementById('newsConnectBtn');

        const sendBtn = document.getElementById('sendBtn');
        const messageInput = document.getElementById('messageInput');
        const messages = document.getElementById('messages');

        var chatSocket = null;
        var newsSocket = null;

        chatConnectBtn.addEventListener('click', (event) => {
            chatSocket = io('http://localhost:3000/chat');
            newsSocket = null;
            chatSocket.on('connect', (socket)=>{
                if(chatSocket) console.log('Chat 네임스페이스 연결');
                // 커넥트 후 메세지 이벤트 발생 여부 확인
                chatSocket.on('message', (msg) => {
                    console.log('server>>>', msg);
                    const li = document.createElement('li');
                    li.innerHTML = msg;
                    messages.appendChild(li);
                });
            });
        });
        newsConnectBtn.addEventListener('click', (event) => {
            newsSocket = io('http://localhost:3000/news');
            chatSocket = null;
            if(newsSocket) console.log('News 네임스페이스 연결');
            // 커넥트 후 메세지 이벤트 발생 여부 확인
            newsSocket.on('message', (msg) => {
                console.log('server>>>', msg);
                const li = document.createElement('li');
                li.innerHTML = msg;
                messages.appendChild(li);
            });
        });

        sendBtn.onclick = function(event) {
            console.log('sendBtn 클릭!');
            if(messageInput.value !== "") {
                if(chatSocket) chatSocket.emit('message', messageInput.value.trim() );
                if(newsSocket) newsSocket.emit('message', messageInput.value.trim() );
                messageInput.value = "";
                return;
            }
            alert("메세지를 입력 하세요!");
            messageInput.focus();
        }
    </script>
</body>
</html>