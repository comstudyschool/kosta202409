<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>채팅 기능 구현</h1>
    <div>
        <button id="chatConnectBtn">Chat 네임스페이스 연결</button>
        <button id="newsConnectBtn">News 네임스페이스 연결</button>
    </div>
    <div>
        <h1>채팅룸 기능</h1>
        방이름: <input type="text" id="roomInput" value="room1" placeholder="방 이름 입력"><br>
        사용자: <input type="text" id="userId" value="user1"><br>
        <button id="joinRoomBtn" style="width:236px">참가</button>
    </div>
    <div>
        <h1>귓속말 기능</h1>
        받는이: <select id="userSelect">
            <option value="all">전체</option>
        </select>
    </div>
    <p>
        메세지: <input type="text" id="messageInput" value="hello world">
        <button id="sendBtn">전송</button>
    </p>
    <div>
        결과: <ul id="messages"></ul>
    </div>
    
    <!-- <script src="/socket.io/socket.io.js"></script> -->
    <script src="https://cdn.socket.io/4.8.0/socket.io.min.js"></script>
    <script>
        const chatConnectBtn = document.getElementById('chatConnectBtn');
        const newsConnectBtn = document.getElementById('newsConnectBtn');

        const sendBtn = document.getElementById('sendBtn');
        const messageInput = document.getElementById('messageInput');
        const messages = document.getElementById('messages');
        const targetId = document.getElementById('targetId');

        var chatSocket = null;
        var newsSocket = null;
        var roomName = "";

        chatConnectBtn.addEventListener('click', (event) => {
            chatSocket = io('http://localhost:3000/chat');
            newsSocket = null;
            chatSocket.on('connect', (socket)=>{
                if(chatSocket) console.log('Chat 네임스페이스 연결');
                // 커넥트 후 메세지 이벤트 발생 여부 확인
                chatSocket.on('message', (msg) => {
                    console.log('server>>>', msg);
                    const li = document.createElement('li');
                    li.innerHTML = msg;
                    messages.appendChild(li);
                });

                chatSocket.on('userListUpdate', (data) => {
                    const userNames = data.userIdList[0].roomName[0];
                    document.getElementById('userSelect').innerHTML = '<option value="all">전체</option>';
                    for(let i in userNames) {
                        const optionTag = document.createElement('option');
                        optionTag.innerHTML = userNames[i];
                        optionTag.setAttribute('value', userNames[i]);
                        document.getElementById('userSelect').appendChild(optionTag);
                    }
                });
            });
        });
        newsConnectBtn.addEventListener('click', (event) => {
            newsSocket = io('http://localhost:3000/news');
            chatSocket = null;
            if(newsSocket) console.log('News 네임스페이스 연결');
            // 커넥트 후 메세지 이벤트 발생 여부 확인
            newsSocket.on('message', (msg) => {
                console.log('server>>>', msg);
                const li = document.createElement('li');
                li.innerHTML = msg;
                messages.appendChild(li);
            });
        });

        document.getElementById('joinRoomBtn').addEventListener('click', (event) => {
            const room = roomInput.value;
            roomName = room; // 다른 이벤트 함수에서 접근 가능 하도록 전역 설정.
            const roomData = {
                room, 
                userId: document.getElementById('userId').value.trim()
            }
            if(newsSocket) newsSocket.emit('joinRoom', roomData);
            if(chatSocket) chatSocket.emit('joinRoom', roomData);
        });

        sendBtn.onclick = function(event) {
            console.log('sendBtn 클릭!');
            if(messageInput.value !== "") {
                const msgObj = {
                    room:roomName,
                    targetUserId: document.getElementById('userSelect').value,
                    msg: messageInput.value.trim()
                };
                if(chatSocket) chatSocket.emit('message', msgObj );
                if(newsSocket) newsSocket.emit('message', msgObj );
                messageInput.value = "";
                return;
            }
            alert("메세지를 입력 하세요!");
            messageInput.focus();
        }
    </script>
</body>
</html>